    {
      "id": "N3",
      "category": "neutral_short",
      "text": "駅を出てから、ゆっくり右へ曲がります。",
      "source": "project_authored"
    },
    {
      "id": "N4",
      "category": "neutral_short",
      "text": "小さな音まで、落ち着いて確かめてください。",
      "source": "project_authored"
    },
    {
      "id": "K2",
      "category": "known_context_drift",
      "text": "智に働けば角が立つ。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    },
    {
      "id": "K3",
      "category": "known_context_drift",
      "text": "情に棹させば流される。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    },
    {
      "id": "K4",
      "category": "known_context_drift",
      "text": "意地を通せば窮屈だ。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    },
    {
      "id": "K5",
      "category": "known_context_drift",
      "text": "とかくに人の世は住みにくい。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    },
    {
      "id": "K6",
      "category": "known_context_drift",
      "text": "住みにくさが高じると、安い所へ引き越したくなる。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    },
    {
      "id": "K7",
      "category": "known_context_drift",
      "text": "どこへ越しても住みにくいと悟った時、詩が生まれて、絵が出来る。",
      "source": "Natsume Soseki, Kusamakura, public-domain text"
    }
