+IrodoriSpeakerCondition
+load_speaker_inversion_embedding(const std::filesystem::path &path,
+                                 const IrodoriModelConfig &config) {
+  constexpr std::string_view kSuffix = ".speaker.safetensors";
+  constexpr std::string_view kTensorKey = "speaker_embedding";
+  constexpr std::uintmax_t kMaximumFileBytes = 8ull * 1024ull * 1024ull;
+  constexpr int64_t kMaximumTokens = 1024;
+
+  const std::string filename = path.filename().string();
+  if (filename.size() < kSuffix.size() ||
+      filename.compare(filename.size() - kSuffix.size(), kSuffix.size(),
+                       kSuffix) != 0) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion file must end with "
+        ".speaker.safetensors");
+  }
+  std::error_code file_error;
+  const auto file_bytes = std::filesystem::file_size(path, file_error);
+  if (file_error) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion file could not be read");
+  }
+  if (file_bytes == 0 || file_bytes > kMaximumFileBytes) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion file size is invalid");
+  }
+
+  const auto source = assets::open_tensor_source(path);
+  const auto metadata = source->require_metadata(kTensorKey);
+  if (metadata.shape.size() != 2) {
+    throw std::runtime_error(
+        "Irodori-TTS speaker_embedding must have shape (tokens, dim)");
+  }
+  const int64_t tokens = metadata.shape[0];
+  const int64_t dimension = metadata.shape[1];
+  if (tokens <= 0 || tokens > kMaximumTokens) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion token count is invalid");
+  }
+  if (dimension != config.speaker_dim) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion dimension does not match the model");
+  }
+  if (metadata.dtype != "F32" && metadata.dtype != "F16" &&
+      metadata.dtype != "BF16") {
+    throw std::runtime_error(
+        "Irodori-TTS speaker_embedding must use a floating-point dtype");
+  }
+  auto state = source->require_f32(
+      kTensorKey,
+      std::optional<std::vector<int64_t>>(metadata.shape));
+  if (static_cast<int64_t>(state.size()) != tokens * dimension) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion tensor size mismatch");
+  }
+  if (!std::all_of(state.begin(), state.end(),
+                   [](float value) { return std::isfinite(value); })) {
+    throw std::runtime_error(
+        "Irodori-TTS Speaker Inversion tensor contains non-finite values");
+  }
+
+  IrodoriSpeakerCondition out;
+  out.state = std::move(state);
+  out.mask.assign(static_cast<size_t>(tokens), 1);
+  out.tokens = tokens;
+  out.has_speaker = true;
+  return out;
+}
